Package: AdaptiveGlasso
Title: Adaptive Graphical Lasso for Sparse Network Estimation
Version: 1.0.0
Authors@R:
    person(
        given = "Elizabeth B.",
        family = "Amona",
        email = "amonaelizabeth1@gmail.com",
        role = c("aut", "cre", "cph"),
        comment = c(ORCID = "0000-0002-7575-788X")
